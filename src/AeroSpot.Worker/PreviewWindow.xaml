<Window x:Class="AeroSpot.Worker.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AeroSpot.Worker"
        xmlns:loc="clr-namespace:AeroSpot.Worker.Localization"
        Title=""
        Width="780" Height="540"
        WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        Focusable="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        KeyDown="Window_KeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel">

    <Window.Resources>
        <!-- Stile Pulsanti Fluent Trasparenti con hover scuro/traslucido e bordo grigio chiaro per evitare contorni bianchi/ciano -->
        <Style x:Key="TransportButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1AFFFFFF"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#71717A"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2EFFFFFF"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#A1A1AA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pulsanti Icona Frameless per Controlli Video/Audio (senza cerchio di sfondo) -->
        <Style x:Key="AppleCircularButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="#0284C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thumb e Slider Video Apple -->
        <Style x:Key="AppleSliderThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Ellipse Width="12" Height="12" Fill="#FFFFFF" Stroke="#33000000" StrokeThickness="1">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.4"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppleSliderRepeatButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppleVideoSlider" TargetType="{x:Type Slider}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center" Height="18" Background="Transparent" Cursor="Hand">
                            <Border Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource AppleSliderRepeatButton}" Command="{x:Static Slider.DecreaseLarge}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource AppleSliderThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource AppleSliderRepeatButton}" Command="{x:Static Slider.IncreaseLarge}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barra di Scorrimento Sottile e Scura (macOS / Fluent dark gray) con Hit-Test confortevole -->
        <Style x:Key="SlimDarkScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="Transparent">
                            <Border x:Name="ThumbVisual" Background="#45454A" CornerRadius="3.5" Margin="3,1,3,1" SnapsToDevicePixels="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbVisual" Property="Background" Value="#71717A"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbVisual" Property="Background" Value="#A1A1AA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <local:MinThumbViewportConverter x:Key="MinThumbViewportConverter" MinThumbLength="44" />

        <Style x:Key="SlimDarkScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.ViewportSize>
                                    <MultiBinding Converter="{StaticResource MinThumbViewportConverter}">
                                        <Binding Path="ViewportSize" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Orientation" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </Track.ViewportSize>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="PART_PageUpButton" Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="PART_Thumb" Style="{StaticResource SlimDarkScrollBarThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="PART_PageDownButton" Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True"/>
                                <Setter Property="Width" Value="14"/>
                                <Setter Property="MinWidth" Value="14"/>
                            </Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter TargetName="PART_PageUpButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                                <Setter TargetName="PART_PageDownButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
                                <Setter Property="Height" Value="14"/>
                                <Setter Property="MinHeight" Value="14"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Stile Thumb di ridimensionamento bordi/angoli (invisibile ma sensibile al mouse su tutta la superficie) -->
        <Style x:Key="ResizeThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stile ContextMenu Dark Fluent per QuickLook -->
        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="#1E232B" BorderBrush="#475569" BorderThickness="1" CornerRadius="8" Padding="5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Separator}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1" Background="#334155" Margin="4,3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="10,6">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu x:Name="PreviewContextMenu" Opened="PreviewContextMenu_Opened">
            <MenuItem x:Name="PreviewMenuOpenPath" Header="{loc:Loc Spotlight_Menu_OpenFilePath}" Click="PreviewMenuOpenPath_Click" FontWeight="SemiBold"/>
            <MenuItem x:Name="PreviewMenuOpenDefault" Header="{loc:Loc Preview_Btn_OpenWithDefault}" Click="PreviewMenuOpenDefault_Click"/>
            <MenuItem x:Name="PreviewMenuCopyPath" Header="{loc:Loc Spotlight_Hint_CopyPath}" Click="PreviewMenuCopyPath_Click"/>
            <Separator x:Name="PreviewMenuSeparatorMedia"/>
            <MenuItem x:Name="PreviewMenuConvertJpg" Header="{loc:Loc Spotlight_Menu_ConvertJpg}" Click="PreviewMenuConvertJpg_Click"/>
            <MenuItem x:Name="PreviewMenuConvertPng" Header="{loc:Loc Spotlight_Menu_ConvertPng}" Click="PreviewMenuConvertPng_Click"/>
            <MenuItem x:Name="PreviewMenuConvertPdf" Header="{loc:Loc Spotlight_Menu_ConvertPdf}" Click="PreviewMenuConvertPdf_Click"/>
            <MenuItem x:Name="PreviewMenuConvertMp3" Header="{loc:Loc Spotlight_Menu_ConvertMp3}" Click="PreviewMenuConvertMp3_Click"/>
            <MenuItem x:Name="PreviewMenuConvertWav" Header="{loc:Loc Spotlight_Menu_ConvertWav}" Click="PreviewMenuConvertWav_Click"/>
            <MenuItem x:Name="PreviewMenuConvertMp4" Header="{loc:Loc Spotlight_Menu_ConvertMp4}" Click="PreviewMenuConvertMp4_Click"/>
            <MenuItem x:Name="PreviewMenuRemoveBg" Header="{loc:Loc Spotlight_Menu_RemoveBg}" Click="PreviewMenuRemoveBg_Click"/>
            <Separator/>
            <MenuItem x:Name="PreviewMenuRememberSize" Header="{loc:Loc Preview_Btn_RememberSize_Tooltip}" Click="PreviewMenuRememberSize_Click"/>
            <MenuItem x:Name="PreviewMenuFullscreen" Header="{loc:Loc Preview_Btn_Fullscreen}" Click="PreviewMenuFullscreen_Click"/>
            <Separator/>
            <MenuItem x:Name="PreviewMenuClose" Header="{loc:Loc Preview_Btn_Close}" Click="PreviewMenuClose_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Ombra esterna sagomata con angoli arrotondati (elimina angoli retti dell'ombra) -->
    <Border Margin="14" CornerRadius="10">
        <Border.Effect>
            <!-- Ombra Fluent equilibrata (Variante 2 predefinita - coordinata con Spotlight) -->
            <DropShadowEffect BlurRadius="30" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.42" />
        </Border.Effect>

        <!-- Finestra principale AeroSpot Preview con bordo coerente per sfondi scuri e angoli arrotondati -->
        <Border Background="#1E1E1E" BorderBrush="#475569" BorderThickness="1.2" CornerRadius="10">
            <Grid>
                <!-- Contenuto con angoli arrotondati e ritaglio -->
                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header Bar -->
                        <RowDefinition Height="*" />    <!-- Content Area -->
                        <RowDefinition Height="Auto" /> <!-- Footer Bar -->
                    </Grid.RowDefinitions>

                <!-- 1. Header Bar (trascinabile con il mouse) -->
                <Border Grid.Row="0" Background="#181818" CornerRadius="9,9,0,0" Padding="14,10" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Icona del file -->
                        <Image x:Name="FileIcon" Grid.Column="0" Width="20" Height="20" Margin="0,0,10,0"
                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />

                        <!-- Titolo e Sottotitolo (Nome e Dettagli/Dimensioni) -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderTitle" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="HeaderSubtitle" FontSize="11" Foreground="#888888" Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Pulsanti Finestra: Zoom, Esporta PDF, Memorizza Dimensioni, Fullscreen, Chiudi -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Reset Zoom (appare se zoom != 1.0) -->
                            <Button x:Name="BtnResetZoom" Content="1:1" Width="32" Height="26" Margin="0,0,6,0" Focusable="False"
                                    Style="{StaticResource TransportButtonStyle}" Foreground="#38BDF8"
                                    FontSize="11" FontWeight="SemiBold" Click="BtnResetZoom_Click"
                                    Visibility="Collapsed" ToolTip="{loc:Loc Preview_ResetZoom_Tooltip}" />
                            <!-- Reset Vista 3D (visibile quando è aperto un modello 3D STL/3MF) -->
                            <Button x:Name="BtnReset3DView" Content="{loc:Loc Preview_Btn_ResetView}" Height="26" Padding="8,0" Margin="0,0,6,0" Focusable="False"
                                    Style="{StaticResource TransportButtonStyle}" Foreground="#38BDF8"
                                    FontSize="11" FontWeight="SemiBold" Click="BtnResetZoom_Click"
                                    Visibility="Collapsed" ToolTip="{loc:Loc Preview_Btn_ResetView_Tooltip}" />
                            <!-- Rotazione manuale 90° orario (solo vista, per Immagini e Video) -->
                            <Button x:Name="BtnRotate" Content="⟳" Width="26" Height="26" Margin="0,0,6,0" Focusable="False"
                                    Style="{StaticResource TransportButtonStyle}"
                                    FontSize="14" Click="BtnRotate_Click" Visibility="Collapsed"
                                    ToolTip="{loc:Loc Preview_Btn_Rotate_Tooltip}" />
                            <!-- Esporta in PDF (visibile per Markdown, Testo e Docx) -->
                            <Button x:Name="BtnExportPdf" Content="📄 PDF" Width="52" Height="26" Margin="0,0,6,0" Focusable="False"
                                    Style="{StaticResource TransportButtonStyle}" Foreground="#38BDF8"
                                    FontSize="11" FontWeight="SemiBold" Click="BtnExportPdf_Click"
                                    Visibility="Collapsed" ToolTip="{loc:Loc Preview_Btn_ExportPdf_Tooltip}" />
                            <!-- Tasto Pin / Memorizza dimensioni persistenti per questo tipo di file -->
                            <Button x:Name="BtnRememberSize" Content="📌" Width="26" Height="26" Margin="0,0,6,0" Focusable="False"
                                    Style="{StaticResource TransportButtonStyle}"
                                    FontSize="11" Click="BtnRememberSize_Click" ToolTip="{loc:Loc Preview_Btn_RememberSize_Tooltip}" />
                            <!-- Schermo Intero ⛶ -->
                            <Button x:Name="BtnFullscreen" Content="⛶" Width="26" Height="26" Margin="0,0,6,0" Focusable="False"
                                    Style="{StaticResource TransportButtonStyle}"
                                    FontSize="13" Click="BtnFullscreen_Click" ToolTip="{loc:Loc Preview_Btn_Fullscreen}" />
                            <!-- Pulsante di chiusura ✕ -->
                            <Button Content="✕" Width="26" Height="26" Focusable="False"
                                    Style="{StaticResource TransportButtonStyle}"
                                    FontSize="12" Click="CloseButton_Click" ToolTip="{loc:Loc Preview_Btn_Close}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Area dei Contenuti -->
                <Grid Grid.Row="1" Background="#141414">
                    <!-- Vista Immagine con Zoom e Pan -->
                    <Border x:Name="ImageView" Visibility="Collapsed" ClipToBounds="True" Background="#141414"
                            PreviewMouseWheel="ImageView_PreviewMouseWheel"
                            MouseLeftButtonDown="ImageView_MouseLeftButtonDown"
                            MouseMove="ImageView_MouseMove"
                            MouseLeftButtonUp="ImageView_MouseLeftButtonUp">
                        <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ImageScaleTransform" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="ImageTranslateTransform" X="0" Y="0" />
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Border>

                    <!-- Vista Video con Fullscreen e Controlli Stile Apple (Capsula Flottante) -->
                    <Border x:Name="VideoView" Visibility="Collapsed" Background="#0A0A0A" ClipToBounds="True">
                        <Grid>
                            <Grid MouseLeftButtonDown="VideoContainer_MouseLeftButtonDown">
                                <MediaElement x:Name="VideoPlayer"
                                              LoadedBehavior="Manual"
                                              UnloadedBehavior="Manual"
                                              ScrubbingEnabled="True"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              MediaOpened="VideoPlayer_MediaOpened"
                                              MediaEnded="VideoPlayer_MediaEnded"
                                              MediaFailed="VideoPlayer_MediaFailed">
                                </MediaElement>

                                <!-- Visualizzatore Audio Giradischi con Vinile Rotante e Braccio/Stanghetta Mobile -->
                                <Grid x:Name="AudioVisualizerPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-10,0,50">
                                    <!-- Giradischi Canvas Container (Vinile rigorosamente al centro) -->
                                    <Grid Width="400" Height="210">
                                        <!-- Piatto / Vinile al Centro con Riflessi di Luce e Tacche di Rotazione -->
                                        <Grid x:Name="VinylPlatter" Width="170" Height="170" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <RotateTransform x:Name="VinylRotateTransform" Angle="0" />
                                            </Grid.RenderTransform>

                                            <!-- Disco Vinile Esterno Nero Satinato con Ombra Profonda -->
                                            <Border Width="170" Height="170" CornerRadius="85" Background="#0C0E14" BorderBrush="#252D3D" BorderThickness="1.5">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="26" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.7"/>
                                                </Border.Effect>
                                            </Border>

                                            <!-- Solchi Concentrici del Vinile Realistici -->
                                            <Ellipse Width="158" Height="158" Stroke="#1E2638" StrokeThickness="1"/>
                                            <Ellipse Width="146" Height="146" Stroke="#161D2B" StrokeThickness="0.8"/>
                                            <Ellipse Width="134" Height="134" Stroke="#222C3D" StrokeThickness="0.8"/>
                                            <Ellipse Width="122" Height="122" Stroke="#161D2B" StrokeThickness="0.8"/>
                                            <Ellipse Width="110" Height="110" Stroke="#222C3D" StrokeThickness="0.8"/>
                                            <Ellipse Width="98" Height="98" Stroke="#161D2B" StrokeThickness="0.8"/>
                                            <Ellipse Width="86" Height="86" Stroke="#222C3D" StrokeThickness="0.8"/>
                                            <Ellipse Width="74" Height="74" Stroke="#161D2B" StrokeThickness="0.8"/>

                                            <!-- Etichetta Centrale del Vinile Autentica (Circolare Perfetta con diciture visibili in rotazione) -->
                                            <Grid Width="64" Height="64">
                                                <!-- Sfondo Circolare Perfetto Bicolore con Bordo Azzurro -->
                                                <Ellipse Width="64" Height="64" Stroke="#38BDF8" StrokeThickness="1.5">
                                                    <Ellipse.Fill>
                                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                            <GradientStop Color="#1D4ED8" Offset="0.0"/>
                                                            <GradientStop Color="#1D4ED8" Offset="0.5"/>
                                                            <GradientStop Color="#0F172A" Offset="0.5001"/>
                                                            <GradientStop Color="#0F172A" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>

                                                <!-- Dicitura superiore del disco (ruota col vinile rendendo il movimento palese) -->
                                                <TextBlock Text="AeroSpot" FontSize="7.5" FontWeight="Bold" Foreground="#FFFFFF"
                                                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/>

                                                <!-- Dicitura inferiore del disco -->
                                                <TextBlock Text="33 ⅓ RPM" FontSize="6.5" FontWeight="SemiBold" Foreground="#94A3B8"
                                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"/>

                                                <!-- Anello decorativo interno -->
                                                <Ellipse Width="34" Height="34" Stroke="#38BDF8" StrokeThickness="0.8" Opacity="0.6"/>

                                                <!-- Foro Centrale del Mandrino come un vero vinile -->
                                                <Ellipse Width="12" Height="12" Fill="#06080D" Stroke="#94A3B8" StrokeThickness="1.2"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>

                                        <!-- Stanghetta del Giradischi (Braccio di lettura metallico orientato verso il vinile) -->
                                        <Grid x:Name="TurntableToneArm" Width="70" Height="140" HorizontalAlignment="Left" VerticalAlignment="Top"
                                              Margin="270,12,0,0" RenderTransformOrigin="0.45,0.14">
                                            <Grid.RenderTransform>
                                                <RotateTransform x:Name="ToneArmRotateTransform" Angle="-18" />
                                            </Grid.RenderTransform>

                                            <!-- Perno di rotazione superiore (Base metallica circolare montata a destra) -->
                                            <Border Width="24" Height="24" CornerRadius="12" Background="#1E293B" BorderBrush="#94A3B8" BorderThickness="1.5"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,7,0,0">
                                                <Ellipse Width="10" Height="10" Fill="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Braccio Metallico (Asta del giradischi inclinata verso il piatto) -->
                                            <Rectangle Width="3.5" Height="82" Fill="#CBD5E1" RadiusX="1.7" RadiusY="1.7"
                                                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,22,0,0">
                                                <Rectangle.RenderTransform>
                                                    <RotateTransform Angle="6" CenterX="1.7" CenterY="0"/>
                                                </Rectangle.RenderTransform>
                                            </Rectangle>

                                            <!-- Testina / Cartuccia con puntina ad angolo che si appoggia sui solchi del vinile -->
                                            <Border Width="10" Height="20" CornerRadius="2.5" Background="#38BDF8" BorderBrush="#0284C7" BorderThickness="1"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="23,98,0,0">
                                                <Border.RenderTransform>
                                                    <RotateTransform Angle="28" CenterX="5" CenterY="10"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>

                            <!-- Floating Apple-Style Capsule Controls (Overlay in basso) -->
                            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                    Margin="0,0,0,18" Padding="14,6"
                                    Background="#D916161A" CornerRadius="20" BorderBrush="#33FFFFFF" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.5"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Play / Pause Icon Button (senza cerchio né riquadri) -->
                                    <Button x:Name="PlayPauseButton" Width="32" Height="32"
                                            Style="{StaticResource AppleCircularButtonStyle}"
                                            Click="PlayPauseButton_Click">
                                        <Path x:Name="PlayPauseIcon"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Stretch="Uniform" Width="13" Height="13"
                                              Data="M 0,0 L 3.5,0 L 3.5,14 L 0,14 Z M 6.5,0 L 10,0 L 10,14 L 6.5,14 Z" />
                                    </Button>

                                    <!-- Current Time (Typography Tabular) -->
                                    <TextBlock x:Name="VideoTimeText" Text="00:00 / 00:00" Foreground="#A1A1AA"
                                               FontFamily="Segoe UI, -apple-system, Cascadia Mono"
                                               FontSize="11" VerticalAlignment="Center" Margin="10,0" />

                                    <!-- Timeline Bar Personalizzata Stile Apple / Fluent -->
                                    <Grid x:Name="TimelineBar" Width="190" Height="24" VerticalAlignment="Center"
                                          Background="Transparent" Cursor="Hand"
                                          MouseLeftButtonDown="TimelineBar_MouseLeftButtonDown"
                                          MouseMove="TimelineBar_MouseMove"
                                          MouseLeftButtonUp="TimelineBar_MouseLeftButtonUp">
                                        <!-- Track di Sfondo -->
                                        <Border Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center"/>
                                        <!-- Barra di Avanzamento Attiva -->
                                        <Border x:Name="TimelineFill" Height="4" CornerRadius="2" Background="#38BDF8"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" Width="0"/>
                                        <!-- Indicatore Thumb Circolare -->
                                        <Ellipse x:Name="TimelineThumb" Width="10" Height="10" Fill="#F8FAFC"
                                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                                 Margin="-5,0,0,0">
                                            <Ellipse.Effect>
                                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                    </Grid>

                                    <!-- Volume Mute Icon Button (senza cerchio) -->
                                    <Button x:Name="VolumeButton" Content="🔊" Width="28" Height="28" Margin="10,0,0,0"
                                            Style="{StaticResource AppleCircularButtonStyle}"
                                            FontSize="16" Click="VolumeButton_Click" />

                                    <!-- Volume Slider Stile Apple -->
                                    <Slider x:Name="VolumeSlider" Width="55" VerticalAlignment="Center"
                                            Minimum="0" Maximum="1" Value="0.5" Margin="6,0,0,0"
                                            Style="{StaticResource AppleVideoSlider}"
                                            ValueChanged="VolumeSlider_ValueChanged" />

                                    <!-- Fullscreen Icon Button (senza cerchio) -->
                                    <Button x:Name="BtnVideoFullscreen" Content="⛶" Width="28" Height="28" Margin="10,0,0,0"
                                            Style="{StaticResource AppleCircularButtonStyle}"
                                            FontSize="16" Click="BtnFullscreen_Click" ToolTip="{loc:Loc Preview_Btn_Fullscreen}" />
                                </StackPanel>
                            </Border>

                            <!-- Overlay Elegante Conversione Audio AC-3 / Bitstream in corso -->
                            <Border x:Name="VideoConversionOverlay" Visibility="Collapsed"
                                    Background="#E60A0A0E" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="44" Height="44" CornerRadius="22" Background="#2638BDF8" BorderBrush="#38BDF8" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,14">
                                        <TextBlock Text="⚡" FontSize="20" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Ottimizzazione audio per QuickLook..." FontSize="13.5" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="VideoConversionSubtext" Text="Conversione traccia multicanale in formato stereo ad alta fedeltà..." FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                                    <ProgressBar x:Name="VideoConversionProgress" Width="220" Height="4" Minimum="0" Maximum="100" Value="0"
                                                 Foreground="#38BDF8" Background="#33FFFFFF" BorderThickness="0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Vista Testo / Codice con ScrollBar Scura Moderna -->
                    <Grid x:Name="TextView" Visibility="Collapsed">
                        <TextBox x:Name="PreviewTextBox"
                                 IsReadOnly="True" AcceptsReturn="True"
                                 Background="#141414" Foreground="#D4D4D4"
                                 FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12.5"
                                 BorderThickness="0" Padding="14,12"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                 PreviewMouseWheel="PreviewTextBox_PreviewMouseWheel">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimDarkScrollBar}" />
                            </TextBox.Resources>
                        </TextBox>
                    </Grid>

                    <!-- Vista Markdown Renderizzato con Tipografia Fluent Scura -->
                    <FlowDocumentScrollViewer x:Name="MarkdownView" Visibility="Collapsed"
                                              Background="#141414"
                                              IsToolBarVisible="False"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              PreviewMouseWheel="MarkdownView_PreviewMouseWheel">
                        <FlowDocumentScrollViewer.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimDarkScrollBar}" />
                        </FlowDocumentScrollViewer.Resources>
                    </FlowDocumentScrollViewer>



                    <!-- Vista Modelli 3D STL Interattiva -->
                    <Grid x:Name="StlView" Visibility="Collapsed" Background="#0A0F1D"
                          MouseLeftButtonDown="StlViewport_MouseLeftButtonDown"
                          MouseMove="StlViewport_MouseMove"
                          MouseLeftButtonUp="StlViewport_MouseLeftButtonUp"
                          MouseWheel="StlViewport_MouseWheel">
                        <Viewport3D x:Name="StlViewport"
                                    ClipToBounds="True"/>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="14" Padding="10,5" CornerRadius="6"
                                Background="#99000000" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <TextBlock Text="{loc:Loc Preview_Stl_Hint}"
                                       Foreground="#94A3B8" FontSize="11"/>
                        </Border>
                    </Grid>

                    <!-- Vista Foglio di Calcolo Excel (XLSX, CSV) Nativo Moderno Dark Fluent -->
                    <Grid x:Name="SpreadsheetView" Visibility="Collapsed" Background="#0C101A">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Barra Superiore Schede Fogli (es. Tabella di marcia, Esempio, Spiegazioni) -->
                        <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="12,8">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="SpreadsheetTabsPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                            </ScrollViewer>
                        </Border>

                        <!-- Griglia Dati del Foglio con Stile Dark Fluent -->
                        <DataGrid x:Name="SpreadsheetDataGrid" Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="#1E293B"
                                  VerticalGridLinesBrush="#1E293B"
                                  Background="#090D16"
                                  RowBackground="#0B1120"
                                  AlternatingRowBackground="#0F172A"
                                  Foreground="#E2E8F0"
                                  BorderThickness="0"
                                  HeadersVisibility="All"
                                  SelectionMode="Extended"
                                  SelectionUnit="Cell"
                                  FontFamily="Segoe UI, Aptos, Consolas"
                                  FontSize="12">
                            <DataGrid.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimDarkScrollBar}" />
                            </DataGrid.Resources>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="BorderBrush" Value="#334155"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowHeaderStyle>
                                <Style TargetType="DataGridRowHeader">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="Width" Value="36"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="BorderBrush" Value="#334155"/>
                                </Style>
                            </DataGrid.RowHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="8,5"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}"
                                                        Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#1E3A8A"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                        </DataGrid>
                    </Grid>

                    <!-- Vista Documento HTML Nativa con Selettore Anteprima / Codice e Apertura Browser -->
                    <Grid x:Name="HtmlView" Visibility="Collapsed" Background="#141414">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Barra degli strumenti HTML -->
                        <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="12,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Toggle Mode: [ 🌐 Anteprima ] [ 📝 Codice ] -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button x:Name="BtnHtmlModePreview" Content="🌐 Anteprima" Height="26" Padding="10,0"
                                            Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11.5"
                                            Cursor="Hand" Click="BtnHtmlModePreview_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4,0,0,4">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button x:Name="BtnHtmlModeCode" Content="📝 Codice" Height="26" Padding="10,0"
                                            Background="#1E293B" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11.5"
                                            Cursor="Hand" Click="BtnHtmlModeCode_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="0,4,4,0">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <!-- Action: [ ↗ Apri nel browser predefinito ] -->
                                <Button Grid.Column="2" x:Name="BtnHtmlOpenBrowser" Content="↗ Apri nel Browser" Height="26" Padding="10,0"
                                        Background="#1E293B" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1"
                                        FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" Click="BtnHtmlOpenBrowser_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#0284C7"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Contenuto: Visualizzatore Documento HTML Nativo e Accelerato da GPU DirectX -->
                        <FlowDocumentScrollViewer Grid.Row="1" x:Name="HtmlDocumentViewer"
                                                  IsSelectionEnabled="True"
                                                  IsToolBarVisible="False"
                                                  Background="#141414"
                                                  Foreground="#E2E8F0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                            <FlowDocumentScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimDarkScrollBar}" />
                            </FlowDocumentScrollViewer.Resources>
                        </FlowDocumentScrollViewer>

                        <!-- Contenuto: Source Code TextBox (Codice Sorgente HTML) -->
                        <TextBox Grid.Row="1" x:Name="HtmlCodeTextBox" Visibility="Collapsed"
                                 Background="#141414" Foreground="#D4D4D4"
                                 FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12.5"
                                 AcceptsReturn="True" AcceptsTab="True" IsReadOnly="True"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0" Padding="16" SelectionBrush="#264F78">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimDarkScrollBar}" />
                            </TextBox.Resources>
                        </TextBox>
                    </Grid>

                    <!-- Vista Documenti PDF Nativa ad Alte Prestazioni (Google PDFium x64) a Scorrimento Continuo con Miniature -->
                    <Grid x:Name="PdfView" Visibility="Collapsed" Background="#141414">
                        <Grid.ColumnDefinitions>
                            <!-- Colonna Sinistra: Barra Laterale Miniature e Navigatore Pagine -->
                            <ColumnDefinition x:Name="PdfSidebarColumn" Width="Auto" />
                            <!-- Colonna Destra: Visualizzatore Principale a Scorrimento Continuo -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Barra Laterale Sinistra: Miniature e Contatore Pagine -->
                        <Grid Grid.Column="0" x:Name="PdfSidebar" Width="144" Background="#11151E" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Bordo di separazione sottile destro -->
                            <Border Grid.RowSpan="2" HorizontalAlignment="Right" Width="1" Background="#1F2937" SnapsToDevicePixels="True" />

                            <!-- Elenco Miniature Scorrevole -->
                            <ScrollViewer Grid.Row="0" x:Name="PdfThumbnailsScrollViewer"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False"
                                          ScrollChanged="PdfThumbnailsScrollViewer_ScrollChanged">
                                <ScrollViewer.Resources>
                                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimDarkScrollBar}" />
                                </ScrollViewer.Resources>
                                <StackPanel x:Name="PdfThumbnailsStack" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,10,0,10" />
                            </ScrollViewer>

                            <!-- Contatore Pagina e Frecce Su/Giu (Posizionato subito sotto l'elenco miniature) -->
                            <Border Grid.Row="1" x:Name="PdfPageCapsule"
                                    Margin="8,6,8,12" Padding="8,4"
                                    Background="#D916161A" CornerRadius="16" BorderBrush="#33FFFFFF" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.4"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Pagina Precedente / Freccia Su ▲ -->
                                    <Button x:Name="BtnPdfPrevPage" Width="26" Height="26" Focusable="False"
                                            Style="{StaticResource AppleCircularButtonStyle}"
                                            Click="BtnPdfPrevPage_Click" ToolTip="Pagina Precedente (Page Up / Freccia Su)">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Stretch="Uniform" Width="9" Height="9"
                                              Data="M 0,7 L 6,1 L 12,7 L 10.5,8.5 L 6,4 L 1.5,8.5 Z" />
                                    </Button>

                                    <!-- Testo Pagina Corrente (es. 1 / 40) -->
                                    <TextBlock x:Name="PdfPageIndicator" Text="1 / 1" Foreground="#CBD5E1"
                                               FontFamily="Segoe UI, -apple-system, Cascadia Mono"
                                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />

                                    <!-- Pagina Successiva / Freccia Giu ▼ -->
                                    <Button x:Name="BtnPdfNextPage" Width="26" Height="26" Focusable="False"
                                            Style="{StaticResource AppleCircularButtonStyle}"
                                            Click="BtnPdfNextPage_Click" ToolTip="Pagina Successiva (Page Down / Freccia Giù)">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Stretch="Uniform" Width="9" Height="9"
                                              Data="M 0,2.5 L 6,8.5 L 12,2.5 L 10.5,1 L 6,5.5 L 1.5,1 Z" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Colonna Destra: Visualizzatore Pagine Principali -->
                        <ScrollViewer Grid.Column="1" x:Name="PdfScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="#141414"
                                      Focusable="True"
                                      ScrollChanged="PdfScrollViewer_ScrollChanged"
                                      PreviewMouseWheel="PdfScrollViewer_PreviewMouseWheel"
                                      PreviewMouseDown="PdfScrollViewer_PreviewMouseDown"
                                      PreviewMouseMove="PdfScrollViewer_PreviewMouseMove"
                                      PreviewMouseUp="PdfScrollViewer_PreviewMouseUp">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimDarkScrollBar}" />
                            </ScrollViewer.Resources>

                            <!-- Contenitore Zoomabile con Pagine Impilate Verticalmente -->
                            <Grid x:Name="PdfPagesContainer" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,18">
                                <Grid.LayoutTransform>
                                    <ScaleTransform x:Name="PdfScaleTransform" ScaleX="1.0" ScaleY="1.0" />
                                </Grid.LayoutTransform>

                                <StackPanel x:Name="PdfPagesStack" Orientation="Vertical" HorizontalAlignment="Center" />
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- Vista Preview Handler Nativo (PDF, Office, RTF, ecc.) -->
                    <Grid x:Name="HandlerView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" x:Name="HandlerHostBorder" Background="#141414" />
                        <ScrollBar Grid.Row="1" x:Name="HandlerHorizontalScrollBar"
                                   Orientation="Horizontal"
                                   Visibility="Collapsed"
                                   Height="14"
                                   Minimum="0" Maximum="1" ViewportSize="0.5"
                                   Style="{StaticResource SlimDarkScrollBar}"
                                   ValueChanged="HandlerHorizontalScrollBar_ValueChanged" />
                    </Grid>

                    <!-- Vista File Generico / Cartella -->
                    <Grid x:Name="GenericView" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="500">
                            <Image x:Name="GenericIcon" Width="52" Height="52" HorizontalAlignment="Center" Margin="0,0,0,14" />
                            <TextBlock x:Name="GenericTitle" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="480" />
                            <TextBlock x:Name="GenericDetails" FontSize="12" Foreground="#A1A1AA" HorizontalAlignment="Center" Margin="0,8,0,16" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="480" LineHeight="18" />

                            <!-- Spinner & Loading per cartelle -->
                            <StackPanel x:Name="FolderSizeLoadingPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14" Visibility="Collapsed">
                                <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse Stroke="#264F78" StrokeThickness="2" />
                                    <Path Stroke="#38BDF8" StrokeThickness="2" Data="M 8,1 A 7,7 0 0 1 15,8" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0" />
                                        </Path.RenderTransform>
                                        <Path.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                                         From="0" To="360" Duration="0:0:0.9" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Path.Triggers>
                                    </Path>
                                </Grid>
                                <TextBlock x:Name="FolderSizeStatusText" Text="{loc:Loc Preview_Folder_Calculating}" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Dimensione Cartella Calcolata -->
                            <TextBlock x:Name="FolderSizeCalculatedText" FontSize="13" FontWeight="SemiBold" Foreground="#4ADE80" HorizontalAlignment="Center" Margin="0,0,0,16" Visibility="Collapsed" />

                            <Button x:Name="OpenDefaultButton" Content="{loc:Loc Preview_Btn_OpenWithDefault}" Padding="18,9" Foreground="#FFFFFF"
                                    FontSize="12" Cursor="Hand" HorizontalAlignment="Center" Click="OpenDefaultButton_Click" Margin="0,4,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="Bd" Background="#264F78" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#71717A"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1E40AF"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A1A1AA"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Vista Errore -->
                    <Grid x:Name="ErrorView" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⚠" FontSize="36" Foreground="#CCA700" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock x:Name="ErrorMessageText" FontSize="13" Foreground="#CCCCCC" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="500" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 3. Footer Bar informativa -->
                <Border Grid.Row="2" Background="#181818" CornerRadius="0,0,9,9" Padding="14,8" BorderBrush="#2D2D2D" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <TextBlock x:Name="FooterDetails" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <TextBlock Text="{loc:Loc Preview_Hint_Open}" FontSize="10.5" Foreground="#888888" Margin="0,0,12,0" />
                            <TextBlock Text="{loc:Loc Preview_Hint_Dismiss}" FontSize="10.5" Foreground="#888888" Margin="0,0,4,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Grip di ridimensionamento invisibili sui 4 lati e 4 angoli per ridimensionamento stile finestra standard (disabilitabili per cartelle) -->
            <Grid x:Name="ResizeThumbsContainer">
                <Thumb Style="{StaticResource ResizeThumbStyle}" Width="4" HorizontalAlignment="Left" Margin="0,14,0,14" Cursor="SizeWE" DragDelta="ResizeLeft_DragDelta" Panel.ZIndex="100"/>
                <Thumb Style="{StaticResource ResizeThumbStyle}" Width="4" HorizontalAlignment="Right" Margin="0,14,0,14" Cursor="SizeWE" DragDelta="ResizeRight_DragDelta" Panel.ZIndex="100"/>
                <Thumb Style="{StaticResource ResizeThumbStyle}" Height="4" VerticalAlignment="Top" Margin="14,0,14,0" Cursor="SizeNS" DragDelta="ResizeTop_DragDelta" Panel.ZIndex="100"/>
                <Thumb Style="{StaticResource ResizeThumbStyle}" Height="4" VerticalAlignment="Bottom" Margin="14,0,14,0" Cursor="SizeNS" DragDelta="ResizeBottom_DragDelta" Panel.ZIndex="100"/>
                <Thumb Style="{StaticResource ResizeThumbStyle}" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" DragDelta="ResizeTopLeft_DragDelta" Panel.ZIndex="101"/>
                <Thumb Style="{StaticResource ResizeThumbStyle}" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" DragDelta="ResizeTopRight_DragDelta" Panel.ZIndex="101"/>
                <Thumb Style="{StaticResource ResizeThumbStyle}" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" DragDelta="ResizeBottomLeft_DragDelta" Panel.ZIndex="101"/>
                <Thumb Style="{StaticResource ResizeThumbStyle}" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="ResizeBottomRight_DragDelta" Panel.ZIndex="101"/>
            </Grid>
        </Grid>
    </Border>
    </Border>
</Window>
