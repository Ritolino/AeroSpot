<Window x:Class="AeroSpot.Worker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AeroSpot.Worker"
        xmlns:loc="clr-namespace:AeroSpot.Worker.Localization"
        Title="AeroSpot"
        Width="680" SizeToContent="Height" MaxHeight="540"
        WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        Topmost="True" Focusable="True"
        PreviewMouseWheel="Window_PreviewMouseWheel">
    
    <Window.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <!-- Stile ScrollBar minimale e scuro -->
        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <ScrollContentPresenter />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stile per ListBoxItem scuro e pulito -->
        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2D2D2D" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#282828" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#333333" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stile ContextMenu Dark Fluent per risultati ricerca -->
        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="#1E232B" BorderBrush="#475569" BorderThickness="1" CornerRadius="8" Padding="5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="MenuBorder" Background="Transparent" CornerRadius="5" Padding="12,7" Margin="1,1">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuBorder" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Ombra esterna sagomata con angoli arrotondati (elimina angoli retti dell'ombra) -->
    <Border Margin="12" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75" />
        </Border.Effect>
        <!-- Finestra principale AeroSpot con bordo ad alto contrasto per sfondi scuri -->
        <Border Background="#1E1E1E" BorderBrush="#475569" BorderThickness="1.2" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Search Box -->
                    <RowDefinition Height="Auto" /> <!-- Separator -->
                    <RowDefinition Height="*" />    <!-- Results List -->
                    <RowDefinition Height="Auto" /> <!-- Footer Bar -->
                </Grid.RowDefinitions>

                <!-- 1. Barra di Ricerca Superiore -->
                <Grid Grid.Row="0" Margin="16,14,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /> <!-- Lente / Icona -->
                        <ColumnDefinition Width="*" />    <!-- Input Textbox -->
                        <ColumnDefinition Width="Auto" /> <!-- Tasto Clear (✕) -->
                    </Grid.ColumnDefinitions>

                    <!-- Icona Lente Di Ricerca (Disegnata in Vettoriale) -->
                    <Path Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0"
                          Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                          Fill="#888888" Stretch="Uniform" Width="18" Height="18" />

                    <!-- Casella di Testo per l'input -->
                    <Grid Grid.Column="1">
                        <!-- Placeholder visibile quando la casella è vuota -->
                        <TextBlock Text="{loc:Loc Spotlight_SearchPlaceholder}"
                                   FontSize="18" Foreground="#555555" VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding HasSearchText, Converter={StaticResource InverseBoolToVisibility}}">
                        </TextBlock>

                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="18" Foreground="#FFFFFF"
                                 Background="Transparent" BorderThickness="0"
                                 CaretBrush="#007ACC" VerticalAlignment="Center"
                                 AcceptsReturn="False" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                    </Grid>

                    <!-- Bottone per cancellare il testo inserito -->
                    <Button Grid.Column="2" Content="✕" Width="24" Height="24"
                            Background="Transparent" Foreground="#888888" BorderThickness="1"
                            Padding="0" FontSize="12" Cursor="Hand" Click="ClearButton_Click"
                            Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <!-- 2. Separatore orizzontale (visibile solo se ci sono risultati) -->
                <Rectangle Grid.Row="1" Height="1" Fill="#2D2D2D" Margin="12,0,12,0"
                           Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}" />

                <!-- 3. Lista dei Risultati (fino a 10 visibili) -->
                <ListBox Grid.Row="2" x:Name="ResultsList"
                         ItemsSource="{Binding FilteredResults}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource ResultItemStyle}"
                         Background="Transparent" BorderThickness="0"
                         Margin="8,6,8,6" MaxHeight="380"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="ResultsList_PreviewKeyDown"
                         MouseDoubleClick="ResultsList_MouseDoubleClick"
                         PreviewMouseRightButtonDown="ResultsList_PreviewMouseRightButtonDown">
                    <ListBox.ContextMenu>
                        <ContextMenu x:Name="ResultsContextMenu">
                            <MenuItem Header="{loc:Loc Spotlight_Menu_OpenFilePath}" Click="ContextOpenPath_Click" FontWeight="SemiBold"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icona file/app (20x20) con scaling ad alta qualità -->
                                <Image Grid.Column="0" Source="{Binding Icon}" Width="20" Height="20" Margin="2,0,12,0"
                                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />

                                <!-- Titolo e Percorso/Descrizione -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="{Binding TitleFontSize}" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#7A7A7A" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <!-- Badge Categoria (es. Applicazione, File, Cartella) -->
                                <Border Grid.Column="2" Background="{Binding BadgeColor}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="10,0,4,0">
                                    <TextBlock Text="{Binding CategoryDisplay}" FontSize="10" FontWeight="Medium" Foreground="{Binding BadgeForeground}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 4. Barra Informativa / Scorciatoie Footer -->
                <Border Grid.Row="3" Background="#181818" CornerRadius="0,0,9,9" Padding="14,6" BorderBrush="#2D2D2D" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Sinistra: Tasto Impostazioni (solo rotella) e Tasto Aggiorna Indice -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="⚙" FontSize="12" Foreground="#888888" Background="Transparent" BorderThickness="1" Padding="6,2" Cursor="Hand" Click="SettingsButton_Click" ToolTip="{loc:Loc Spotlight_Btn_Settings}" Margin="0,0,8,0"/>
                            <Button x:Name="BtnReindexNow" Content="{loc:Loc Spotlight_Btn_Reindex}" FontSize="10" Foreground="#888888" Background="Transparent" BorderThickness="1" Padding="6,2" Cursor="Hand" Click="ReindexNowButton_Click" VerticalAlignment="Center" ToolTip="{loc:Loc Spotlight_IndexStatus_Updating}" />
                        </StackPanel>

                        <!-- Centro: Scritta AeroSpot centrata -->
                        <TextBlock Grid.Column="1" Text="AeroSpot" FontSize="11" FontWeight="Bold" Foreground="#555555" HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <!-- Destra: Scorciatoie rapide da tastiera -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Spotlight_Hint_Open}" FontSize="10" Foreground="#888888" Margin="0,0,12,0" />
                            <TextBlock Text="{loc:Loc Spotlight_Hint_Navigate}" FontSize="10" Foreground="#888888" Margin="0,0,12,0" />
                            <TextBlock Text="{loc:Loc Spotlight_Hint_Dismiss}" FontSize="10" Foreground="#888888" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
