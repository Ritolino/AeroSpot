<Window x:Class="AeroSpot.Worker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AeroSpot.Worker"
        xmlns:loc="clr-namespace:AeroSpot.Worker.Localization"
        Title="AeroSpot"
        Width="680" SizeToContent="Height" MaxHeight="540"
        WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        Topmost="True" Focusable="True"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        PreviewKeyDown="Window_PreviewKeyDown">
    
    <Window.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <!-- Stile Filter Pill Fluent Dark -->
        <Style x:Key="FilterPillButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#262C36"/>
            <Setter Property="BorderBrush" Value="#3B4252"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stile ScrollBar minimale e scuro -->
        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <ScrollContentPresenter />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stile pulsanti discreti grigi per Impostazioni e Aggiorna Indice -->
        <Style x:Key="ReindexButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#1AFFFFFF"/>
                                <Setter TargetName="Brd" Property="BorderBrush" Value="#555555"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#26FFFFFF"/>
                                <Setter TargetName="Brd" Property="BorderBrush" Value="#666666"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Brd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stile per ListBoxItem scuro e pulito -->
        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2D2D2D" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#282828" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#333333" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stile ContextMenu Dark Fluent per risultati ricerca -->
        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="#1E232B" BorderBrush="#475569" BorderThickness="1" CornerRadius="8" Padding="5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Separator}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1" Background="#334155" Margin="4,3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="MenuBorder" Background="Transparent" CornerRadius="5" Padding="12,7" Margin="1,1">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuBorder" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Ombra esterna sagomata con angoli arrotondati (elimina angoli retti dell'ombra) -->
    <Border Margin="14" CornerRadius="10">
        <Border.Effect>
            <!-- Ombra Fluent equilibrata (Variante 2 predefinita - confrontabile con Variante 1 e 3 in Correzioni_Schermate) -->
            <DropShadowEffect BlurRadius="30" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.42" />
        </Border.Effect>
        <!-- Finestra principale AeroSpot con bordo ad alto contrasto per sfondi scuri -->
        <Border Background="#1E1E1E" BorderBrush="#475569" BorderThickness="1.2" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Search Box -->
                    <RowDefinition Height="Auto" /> <!-- Category Filter Bar -->
                    <RowDefinition Height="Auto" /> <!-- Separator -->
                    <RowDefinition Height="*" />    <!-- Results List -->
                    <RowDefinition Height="Auto" /> <!-- Footer Bar -->
                </Grid.RowDefinitions>

                <!-- 1. Barra di Ricerca Superiore -->
                <Grid Grid.Row="0" Margin="16,14,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /> <!-- Lente / Icona -->
                        <ColumnDefinition Width="*" />    <!-- Input Textbox -->
                        <ColumnDefinition Width="Auto" /> <!-- Tasto Clear (✕) -->
                    </Grid.ColumnDefinitions>

                    <!-- Icona Lente Di Ricerca (Disegnata in Vettoriale) -->
                    <Path Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0"
                          Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                          Fill="#888888" Stretch="Uniform" Width="18" Height="18" />

                    <!-- Casella di Testo per l'input -->
                    <Grid Grid.Column="1">
                        <!-- Placeholder visibile quando la casella è vuota -->
                        <TextBlock Text="{loc:Loc Spotlight_SearchPlaceholder}"
                                   FontSize="18" Foreground="#555555" VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding HasSearchText, Converter={StaticResource InverseBoolToVisibility}}">
                        </TextBlock>

                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="18" Foreground="#FFFFFF"
                                 Background="Transparent" BorderThickness="0"
                                 CaretBrush="#007ACC" VerticalAlignment="Center"
                                 AcceptsReturn="False" PreviewKeyDown="SearchBox_PreviewKeyDown"
                                 PreviewMouseLeftButtonDown="SearchBox_PreviewMouseLeftButtonDown"
                                 GotFocus="SearchBox_GotFocus" />
                    </Grid>

                    <!-- Bottone per cancellare il testo inserito (Icona vettoriale circolare centrata otticamente, senza contorno) -->
                    <Button Grid.Column="2" x:Name="ClearButton"
                            Width="20" Height="20" Margin="8,0,0,0"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Cursor="Hand" Click="ClearButton_Click"
                            AutomationProperties.Name="{loc:Loc Spotlight_Clear_Search}"
                            Focusable="False" FocusVisualStyle="{x:Null}"
                            Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisibility}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CircleBorder" Width="20" Height="20" CornerRadius="10"
                                        Background="Transparent" BorderThickness="0"
                                        SnapsToDevicePixels="True" UseLayoutRounding="True">
                                    <Path x:Name="CrossPath" Data="M 6,6 L 14,14 M 14,6 L 6,14"
                                          Stroke="#94A3B8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Width="10" Height="10" Stretch="Uniform"
                                          SnapsToDevicePixels="True" UseLayoutRounding="True" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CircleBorder" Property="Background" Value="#26FFFFFF" />
                                        <Setter TargetName="CrossPath" Property="Stroke" Value="#F8FAFC" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="CircleBorder" Property="Background" Value="#33FFFFFF" />
                                        <Setter TargetName="CrossPath" Property="Stroke" Value="#38BDF8" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- 1.5. Barra Filtri Categoria Spotlight (Pills Fluent Dark - Centrati) -->
                <ScrollViewer Grid.Row="1" HorizontalAlignment="Center" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Margin="16,0,16,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="FilterBtnAll" Tag="All" Content="{loc:Loc Spotlight_Filter_All}"
                                Style="{StaticResource FilterPillButtonStyle}" Click="FilterPill_Click" />
                        <Button x:Name="FilterBtnApps" Tag="Applicazione" Content="{loc:Loc Spotlight_Filter_Apps}"
                                Style="{StaticResource FilterPillButtonStyle}" Click="FilterPill_Click" Margin="6,0,0,0" />
                        <Button x:Name="FilterBtnPhotos" Tag="Immagine" Content="{loc:Loc Spotlight_Filter_Photos}"
                                Style="{StaticResource FilterPillButtonStyle}" Click="FilterPill_Click" Margin="6,0,0,0" />
                        <Button x:Name="FilterBtnDocs" Tag="Documento" Content="{loc:Loc Spotlight_Filter_Documents}"
                                Style="{StaticResource FilterPillButtonStyle}" Click="FilterPill_Click" Margin="6,0,0,0" />
                        <Button x:Name="FilterBtnVideos" Tag="Video" Content="{loc:Loc Spotlight_Filter_Videos}"
                                Style="{StaticResource FilterPillButtonStyle}" Click="FilterPill_Click" Margin="6,0,0,0" />
                        <Button x:Name="FilterBtnAudio" Tag="Audio" Content="{loc:Loc Spotlight_Filter_Audio}"
                                Style="{StaticResource FilterPillButtonStyle}" Click="FilterPill_Click" Margin="6,0,0,0" />
                        <Button x:Name="FilterBtnFolders" Tag="Cartella" Content="{loc:Loc Spotlight_Filter_Folders}"
                                Style="{StaticResource FilterPillButtonStyle}" Click="FilterPill_Click" Margin="6,0,0,0" />
                        <Button x:Name="FilterBtnSettings" Tag="Impostazioni" Content="{loc:Loc Spotlight_Filter_Settings}"
                                Style="{StaticResource FilterPillButtonStyle}" Click="FilterPill_Click" Margin="6,0,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 2. Separatore orizzontale (visibile solo se ci sono risultati) -->
                <Rectangle Grid.Row="2" Height="1" Fill="#2D2D2D" Margin="12,0,12,0"
                           Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}" />

                <!-- 3. Lista dei Risultati (fino a 10 visibili) -->
                <ListBox Grid.Row="3" x:Name="ResultsList"
                         ItemsSource="{Binding FilteredResults}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource ResultItemStyle}"
                         Background="Transparent" BorderThickness="0"
                         Margin="8,6,8,6" MaxHeight="380"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="ResultsList_PreviewKeyDown"
                         MouseDoubleClick="ResultsList_MouseDoubleClick"
                         PreviewMouseLeftButtonDown="ResultsList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="ResultsList_PreviewMouseMove"
                         PreviewMouseLeftButtonUp="ResultsList_PreviewMouseLeftButtonUp"
                         PreviewMouseRightButtonDown="ResultsList_PreviewMouseRightButtonDown">
                    <ListBox.ContextMenu>
                        <ContextMenu x:Name="ResultsContextMenu" Opened="ResultsContextMenu_Opened">
                            <MenuItem x:Name="MenuOpenPath" Header="{loc:Loc Spotlight_Menu_OpenFilePath}" Click="ContextOpenPath_Click" FontWeight="SemiBold"/>
                            <MenuItem x:Name="MenuCopyPath" Header="{loc:Loc Spotlight_Menu_CopyPath}" Click="ContextCopyPath_Click"/>
                            <Separator x:Name="MenuSeparatorMedia"/>
                            <MenuItem x:Name="MenuConvertJpg" Header="{loc:Loc Spotlight_Menu_ConvertJpg}" Click="ContextConvertJpg_Click"/>
                            <MenuItem x:Name="MenuConvertPng" Header="{loc:Loc Spotlight_Menu_ConvertPng}" Click="ContextConvertPng_Click"/>
                            <MenuItem x:Name="MenuConvertPdf" Header="{loc:Loc Spotlight_Menu_ConvertPdf}" Click="ContextConvertPdf_Click"/>
                            <MenuItem x:Name="MenuConvertMp3" Header="{loc:Loc Spotlight_Menu_ConvertMp3}" Click="ContextConvertMp3_Click"/>
                            <MenuItem x:Name="MenuConvertWav" Header="{loc:Loc Spotlight_Menu_ConvertWav}" Click="ContextConvertWav_Click"/>
                            <MenuItem x:Name="MenuConvertMp4" Header="{loc:Loc Spotlight_Menu_ConvertMp4}" Click="ContextConvertMp4_Click"/>
                            <MenuItem x:Name="MenuRemoveBg" Header="{loc:Loc Spotlight_Menu_RemoveBg}" Click="ContextRemoveBg_Click"/>
                            <Separator x:Name="MenuSeparatorDelete"/>
                            <MenuItem x:Name="MenuRecycleFile" Header="{loc:Loc Spotlight_Menu_RecycleFile}" Click="ContextRecycleFile_Click" Foreground="#EF4444"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icona file/app (20x20) con scaling ad alta qualità -->
                                <Image Grid.Column="0" Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,12,0"
                                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />

                                <!-- Titolo e Percorso/Descrizione -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="{Binding TitleFontSize}" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#7A7A7A" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <!-- Badge Categoria (es. Applicazione, File, Cartella) -->
                                <Border Grid.Column="2" Background="{Binding BadgeColor}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="10,0,4,0">
                                    <TextBlock Text="{Binding CategoryDisplay}" FontSize="10" FontWeight="Medium" Foreground="{Binding BadgeForeground}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 4. Barra Informativa / Scorciatoie Footer -->
                <Border Grid.Row="4" Background="#181818" CornerRadius="0,0,9,9" Padding="14,6" BorderBrush="#2D2D2D" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Sinistra: Tasto Impostazioni (solo rotella) e Tasto Aggiorna Indice -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="⚙" Style="{StaticResource ReindexButtonStyle}" Padding="6,2" FontSize="11" Click="SettingsButton_Click" ToolTip="{loc:Loc Spotlight_Btn_Settings}" Margin="0,0,8,0"/>
                            <Button x:Name="BtnReindexNow" Style="{StaticResource ReindexButtonStyle}" Content="{loc:Loc Spotlight_Btn_Reindex}" Click="ReindexNowButton_Click" VerticalAlignment="Center" ToolTip="{loc:Loc Spotlight_IndexStatus_Updating}" />
                        </StackPanel>

                        <!-- Centro: Scritta AeroSpot centrata -->
                        <TextBlock Grid.Column="1" Text="AeroSpot" FontSize="11" FontWeight="Bold" Foreground="#555555" HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <!-- Destra: Scorciatoie rapide da tastiera -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Spotlight_Hint_Open}" FontSize="10" Foreground="#888888" Margin="0,0,12,0" />
                            <TextBlock Text="{loc:Loc Spotlight_Hint_Navigate}" FontSize="10" Foreground="#888888" Margin="0,0,12,0" />
                            <TextBlock Text="{loc:Loc Spotlight_Hint_Dismiss}" FontSize="10" Foreground="#888888" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
